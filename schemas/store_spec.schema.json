{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoboost.ai/schemas/store-spec-1.0.0.json",
  "title": "Echoboost StoreSpec",
  "description": "Canonical AI-generated store configuration for the Echoboost storefront renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "store",
    "branding",
    "navigation",
    "homepage",
    "catalog",
    "pages",
    "commerce",
    "footer",
    "seo",
    "responsive"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },

    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "industry", "description", "target_audience", "locale", "currency"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },

    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "colors", "typography"],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary", "accent", "background", "text"],
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "background": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading", "body"],
          "properties": {
            "heading": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        }
      }
    },

    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },

    "homepage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_variant", "hero", "sections"],
      "properties": {
        "layout_variant": {
          "type": "string",
          "minLength": 1
        },

        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "subheadline", "primary_cta"],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1
            },
            "subheadline": {
              "type": "string"
            },
            "primary_cta": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },

        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "categories"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "source", "limit"],
                "properties": {
                  "type": {
                    "const": "featured_products"
                  },
                  "source": {
                    "enum": ["all_products", "category"]
                  },
                  "category_id": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "source": {
                          "const": "category"
                        }
                      }
                    },
                    "then": {
                      "required": ["category_id"]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "promotional_banner"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "testimonials"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "faq"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "about"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "newsletter"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "const": "trust"
                  }
                }
              }
            ]
          }
        }
      }
    },

    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "product_card", "sorting", "filters"],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },

        "product_card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image_ratio", "show_price", "show_rating", "show_badge", "show_quick_add"],
          "properties": {
            "image_ratio": {
              "enum": ["1:1", "4:5", "3:4", "4:3", "16:9"]
            },
            "show_price": {
              "type": "boolean"
            },
            "show_rating": {
              "type": "boolean"
            },
            "show_badge": {
              "type": "boolean"
            },
            "show_quick_add": {
              "type": "boolean"
            }
          }
        },

        "sorting": {
          "type": "array",
          "items": {
            "enum": [
              "featured",
              "newest",
              "oldest",
              "price_low_to_high",
              "price_high_to_low",
              "name_a_to_z",
              "name_z_to_a"
            ]
          }
        },

        "filters": {
          "type": "array",
          "items": {
            "enum": ["category", "price", "availability", "rating"]
          }
        }
      }
    },

    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["about", "contact", "faq"],
      "properties": {
        "about": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "faq": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },

    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout", "shipping", "payments"],
      "properties": {
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guest_checkout", "account_required"],
          "properties": {
            "guest_checkout": {
              "type": "boolean"
            },
            "account_required": {
              "type": "boolean"
            }
          }
        },

        "shipping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },

        "payments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },

    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "enum": ["navigation", "contact", "social", "legal", "newsletter"]
          }
        }
      }
    },

    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "keywords"],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mobile", "tablet", "desktop"],
      "properties": {
        "mobile": {
          "$ref": "#/$defs/responsiveBreakpoint"
        },
        "tablet": {
          "$ref": "#/$defs/responsiveBreakpoint"
        },
        "desktop": {
          "$ref": "#/$defs/responsiveBreakpoint"
        }
      }
    }
  },

  "$defs": {
    "responsiveBreakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    }
  }
}
